local lastScan = 0
bind(RS.Heartbeat, function()
    if not S.nick then
        if next(changed) or tag then restoreAll() end
        info.Text = "Настоящий ник: " .. realDisp .. " (@" .. realName .. ")\nСейчас показывается: выкл"
        return
    end
    local col = nickColor()
    for lbl in pairs(changed) do
        if lbl.Parent then lbl.TextColor3 = col else changed[lbl] = nil end
    end

    local head = lp.Character and lp.Character:FindFirstChild("Head")
    local h = hum()
    if head and h then
        if not tag or tag.Adornee ~= head then
            if tag then tag:Destroy() end
            tag = Instance.new("BillboardGui")
            tag.Size = UDim2.new(0, 220, 0, 30) tag.StudsOffset = Vector3.new(0, 2.6, 0)
            tag.AlwaysOnTop = true tag.Adornee = head tag.Parent = gui
            local tx = Instance.new("TextLabel") tx.Name = "T" tx.Size = UDim2.new(1, 0, 1, 0)
            tx.BackgroundTransparency = 1 tx.Font = Enum.Font.GothamBold tx.TextSize = 18
            tx.TextStrokeTransparency = 0 tx.Parent = tag
        end
        if not oldDDT then oldDDT = h.DisplayDistanceType end
        h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        tag.T.Text = fakeName() tag.T.TextColor3 = col
    end

    if tick() - lastScan > 1 then
        lastScan = tick()
        scan(col)
        info.Text = "Настоящий ник: " .. realDisp .. " (@" .. realName .. ")\nСейчас показывается: " .. fakeName()
    end
end)

