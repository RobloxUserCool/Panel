-- логика
bind(UIS.JumpRequest, function()
    local h = hum() if S.inf and h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
end)
bind(lp.Idled, function()
    if S.afk then local vu = game:GetService("VirtualUser") vu:CaptureController() vu:ClickButton2(Vector2.new()) end
end)
bind(RS.Stepped, function()
    if S.noclip and lp.Character then
        for _, p in ipairs(lp.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)
bind(RS.Heartbeat, function()
    local h, r = hum(), root()
    if h then
        if S.speed then h.WalkSpeed = S.speedVal end
        if S.jump then h.UseJumpPower = true h.JumpPower = S.jumpVal end
    end
    if S.fov then cam.FieldOfView = S.fovVal end
    if S.fb then L.Brightness = 2 L.ClockTime = 14 L.FogEnd = 1e6 L.Ambient = Color3.new(1,1,1) end
    if S.fly and h and r then
        if not fbv or fbv.Parent ~= r then startFly() end
        local m = h.MoveDirection
        local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
        local f = Vector3.new(look.X, 0, look.Z).Unit
        local rt = Vector3.new(right.X, 0, right.Z).Unit
        local vel = look * m:Dot(f) + right * m:Dot(rt)
        fbv.Velocity = vel * S.flyVal
        fbg.CFrame = cam.CFrame
    end
end)
