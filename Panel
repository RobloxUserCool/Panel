    local f = Instance.new("Frame") f.Size = UDim2.new(1, -6, 0, 34) f.BackgroundColor3 = BTN f.Parent = page corner(f, 6)
    local l = Instance.new("TextLabel") l.Size = UDim2.new(0.6, 0, 1, 0) l.Position = UDim2.new(0, 10, 0, 0)
    l.BackgroundTransparency = 1 l.Text = text l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextColor3 = Color3.new(1,1,1) l.Font = Enum.Font.Gotham l.TextSize = 14 l.Parent = f
    local t = Instance.new("TextBox") t.Size = UDim2.new(0.3, 0, 0, 24) t.Position = UDim2.new(0.68, 0, 0.5, -12)
