-- ESP
local esp = {}
local function refreshESP(p)
    if esp[p] then esp[p]:Destroy() esp[p] = nil end
    if S.esp and p.Character then
        local h = Instance.new("Highlight")
        h.FillColor = Color3.fromRGB(255,60,60) h.FillTransparency = 0.5
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Adornee = p.Character h.Parent = gui esp[p] = h
    end
end
local function hook(p) if p ~= lp then bind(p.CharacterAdded, function() task.wait(0.3) refreshESP(p) end) end end
for _, p in ipairs(Players:GetPlayers()) do hook(p) end
bind(Players.PlayerAdded, hook)
bind(Players.PlayerRemoving, function(p) if esp[p] then esp[p]:Destroy() esp[p] = nil end end)

-- Fly
local fbv, fbg
local function stopFly()
    if fbv then fbv:Destroy() fbv = nil end
    if fbg then fbg:Destroy() fbg = nil end
    local h = hum() if h then h.PlatformStand = false end
end
local function startFly()
    local r, h = root(), hum() if not r or not h then return end
    stopFly()
    fbv = Instance.new("BodyVelocity") fbv.MaxForce = Vector3.new(9e9,9e9,9e9) fbv.Velocity = Vector3.zero fbv.Parent = r
    fbg = Instance.new("BodyGyro") fbg.MaxTorque = Vector3.new(9e9,9e9,9e9) fbg.P = 9e4 fbg.CFrame = cam.CFrame fbg.Parent = r
    h.PlatformStand = true
end

