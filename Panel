local pages, tabBtns = {}, {}
local function showPage(name)
    for n, p in pairs(pages) do p.Visible = (n == name) end
    for n, b in pairs(tabBtns) do b.BackgroundColor3 = (n == name) and ACC or BTN end
end
local function newPage(name)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1/4, -3, 1, 0) b.Text = name b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold b.TextSize = 12 b.BackgroundColor3 = BTN b.Parent = tabBar corner(b, 6)
    local p = Instance.new("ScrollingFrame")
    p.Size = UDim2.new(1, -10, 1, -76) p.Position = UDim2.new(0, 5, 0, 72)
    p.BackgroundTransparency = 1 p.BorderSizePixel = 0 p.ScrollBarThickness = 3
    p.AutomaticCanvasSize = Enum.AutomaticSize.Y p.CanvasSize = UDim2.new() p.Visible = false p.Parent = main
    local ll = Instance.new("UIListLayout") ll.Padding = UDim.new(0, 6) ll.Parent = p
    pages[name], tabBtns[name] = p, b
    b.MouseButton1Click:Connect(function() showPage(name) end)
    return p
end

local function toggle(page, text, key, cb)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -6, 0, 34) b.Font = Enum.Font.Gotham b.TextSize = 14
    b.TextColor3 = Color3.new(1,1,1) b.Parent = page corner(b, 6)
    local function r() b.Text = text .. (S[key] and "  [ВКЛ]" or "  [ВЫКЛ]") b.BackgroundColor3 = S[key] and Color3.fromRGB(50,150,80) or BTN end
    r()
    b.MouseButton1Click:Connect(function() S[key] = not S[key] r() if cb then cb(S[key]) end end)
end
