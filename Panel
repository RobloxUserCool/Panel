-- === НИК ===
S.nick, S.nickName, S.nickRainbow, S.nickHex = false, "", true, "FF4040"
local CoreGui = game:GetService("CoreGui")
local realName, realDisp = lp.Name, lp.DisplayName
local changed = {}
local tag, oldDDT

local function fakeName() return (S.nickName ~= "" and S.nickName) or realDisp end
local function nickColor()
    if S.nickRainbow then return Color3.fromHSV((tick() * 0.5) % 1, 1, 1) end
    local ok, c = pcall(Color3.fromHex, (S.nickHex:gsub("#", "")))
    return ok and c or Color3.new(1, 1, 1)
end

local function restoreAll()
    for lbl, o in pairs(changed) do
        pcall(function() lbl.Text = o.text lbl.TextColor3 = o.color end)
    end
    changed = {}
    if tag then tag:Destroy() tag = nil end
    local h = hum()
    if h and oldDDT then h.DisplayDistanceType = oldDDT end
    oldDDT = nil
end
gui.Destroying:Connect(restoreAll)

local function scan(col)
    local name = fakeName()
    local user = "@" .. (name:gsub("%s", ""))
    local ok, list = pcall(function() return CoreGui:GetDescendants() end)
    if not ok then return end
    for _, o in ipairs(list) do
        if (o:IsA("TextLabel") or o:IsA("TextButton")) and not o:IsDescendantOf(gui) then
            local t = o.Text
            local new
            if t == realDisp or t == realName then new = name
            elseif t == "@" .. realName or t == "@" .. realDisp then new = user end
            if new then
                if not changed[o] then changed[o] = {text = t, color = o.TextColor3} end
                o.Text = new
                o.TextColor3 = col
            end
        end
    end
end

